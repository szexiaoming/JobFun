# AI Provider: "deepseek" (default) or "anthropic"
AI_PROVIDER=deepseek

# DeepSeek API (OpenAI-compatible)
# structured/agent/evaluation tasks use FAST; reasoning uses REASONING.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_REASONING=deepseek-reasoner

# Anthropic API (optional, required for vision/image JD support)
# The configured model currently serves every Anthropic capability.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI speech-to-text (independent from AI_PROVIDER)
# Required only for interview audio transcription.
OPENAI_API_KEY=sk-openai-...
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Paths
DATA_DIR=data
SQLITE_PATH=data/sqlite/jobfun.db
UPLOAD_DIR=data/uploads
RESUME_DIR=data/resumes
INTERVIEW_AUDIO_DIR=data/interview_audio
OBJECT_STORAGE_DIR=data/objects

# Service persistence adapters
DATABASE_BACKEND=sqlite
# POSTGRES_DSN=postgresql://jobfun:password@localhost:5432/jobfun
OBJECT_STORAGE_BACKEND=local
MAX_DATA_EXPORT_SIZE_MB=250
# S3_BUCKET=jobfun-private
# S3_REGION=eu-west-2
# S3_ENDPOINT_URL=
# S3_KMS_KEY_ID=

# FastAPI delivery adapter (Iteration 0.20)
JOBFUN_API_TITLE=JobFun API
JOBFUN_API_VERSION=0.31.0
JOBFUN_API_ENV=development

# Worker monitoring and structured logs (Iteration 0.34)
JOBFUN_LOG_FORMAT=text
JOBFUN_WORKER_NAME=default
JOBFUN_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
JOBFUN_WORKER_QUEUE_MAX_AGE_SECONDS=300
JOBFUN_WORKER_RUNNING_STALE_SECONDS=900
JOBFUN_RETAINED_AUDIO_MAX_DAYS=30
JOBFUN_AUDIO_CLEANUP_MAX_AGE_HOURS=36
JOBFUN_AUDIO_CLEANUP_STALE_SECONDS=1800
JOBFUN_AUDIO_CLEANUP_FAILURE_THRESHOLD=2
JOBFUN_MAINTENANCE_HISTORY_MAX_ROWS=90
# Optional authenticated maintenance exports. Keep old keys during rotation.
# JOBFUN_MAINTENANCE_EXPORT_ACTIVE_KEY_ID=2026-q4
# JOBFUN_MAINTENANCE_EXPORT_HMAC_KEYS_JSON={"2026-q3":"BASE64_32_TO_64_BYTES","2026-q4":"BASE64_32_TO_64_BYTES"}

# Optional failure webhook. Events contain no user ID or task payload.
# JOBFUN_ALERT_WEBHOOK_URL=https://alerts.example.com/jobfun
# JOBFUN_ALERT_WEBHOOK_BEARER_TOKEN=
JOBFUN_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
