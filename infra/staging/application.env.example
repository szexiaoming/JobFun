# Combined release manifest for `python -m src.ops.preflight --env-file ...`.
# Keep the real file outside version control and inject the same values into
# the API, Worker and Web processes according to their ownership boundaries.

JOBFUN_API_ENV=staging
JOBFUN_API_VERSION=0.31.0
DATABASE_BACKEND=postgres
POSTGRES_DSN=postgresql://jobfun_staging:replace-secret@127.0.0.1:55432/jobfun_staging

OBJECT_STORAGE_BACKEND=s3
S3_BUCKET=jobfun-private-staging
S3_REGION=local
S3_ENDPOINT_URL=http://127.0.0.1:59000

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-secret
# OPENAI_API_KEY=replace-secret

JOBFUN_LOG_FORMAT=json
JOBFUN_WORKER_NAME=staging-worker-01
JOBFUN_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
JOBFUN_WORKER_QUEUE_MAX_AGE_SECONDS=300
JOBFUN_WORKER_RUNNING_STALE_SECONDS=900
JOBFUN_RETAINED_AUDIO_MAX_DAYS=30
JOBFUN_AUDIO_CLEANUP_MAX_AGE_HOURS=36
JOBFUN_AUDIO_CLEANUP_STALE_SECONDS=1800
JOBFUN_AUDIO_CLEANUP_FAILURE_THRESHOLD=2
JOBFUN_MAINTENANCE_HISTORY_MAX_ROWS=90
# Optional authenticated maintenance exports. Keep old keys during rotation.
# JOBFUN_MAINTENANCE_EXPORT_ACTIVE_KEY_ID=2026-q4
# JOBFUN_MAINTENANCE_EXPORT_HMAC_KEYS_JSON={"2026-q3":"BASE64_32_TO_64_BYTES","2026-q4":"BASE64_32_TO_64_BYTES"}

JOBFUN_API_BASE_URL=https://staging-api.example.test/api/v1
JOBFUN_COOKIE_SECURE=true
# JOBFUN_ALERT_WEBHOOK_URL=https://alerts.example.test/jobfun
# JOBFUN_ALERT_WEBHOOK_BEARER_TOKEN=replace-secret

