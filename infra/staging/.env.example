# Isolated local staging only. Copy to .env and replace every placeholder.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=jobfun_staging
POSTGRES_USER=jobfun_staging
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
POSTGRES_PORT=55432

# Pin approved MinIO images before starting the environment.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=jobfun_staging
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-secret
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_BUCKET=jobfun-private-staging

